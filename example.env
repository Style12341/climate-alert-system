# Every variable read by climate_alerts.config.Settings, with its default.
# Copy this file to .env and fill in the required values.

# --- Required: there is no default and the application refuses to start
# --- without them.
DATABASE_URL=postgresql+asyncpg://climate:CHANGE_ME@localhost:5432/climate_alerts
# At least 32 characters.
JWT_SECRET=

# --- Authentication
# One of HS256, HS384, HS512.
JWT_ALGORITHM=HS256

# --- Alert evaluation
EVALUATION_INTERVAL_SECONDS=300
EVALUATION_CHUNK_SIZE=5000
# Comma-separated list of channels; at least one.
NOTIFICATION_CHANNELS=whatsapp

# --- Notification dispatch
DISPATCH_INTERVAL_SECONDS=5
DISPATCH_BATCH_SIZE=500
DISPATCH_CONCURRENCY=40
DISPATCH_SEND_TIMEOUT_SECONDS=10
# Must exceed DISPATCH_BATCH_SIZE / DISPATCH_CONCURRENCY * DISPATCH_SEND_TIMEOUT_SECONDS.
DISPATCH_LEASE_SECONDS=300
DISPATCH_MAX_ATTEMPTS=8
DISPATCH_BACKOFF_BASE_SECONDS=60
DISPATCH_BACKOFF_CAP_SECONDS=3600

# --- Database pool
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_COMMAND_TIMEOUT_SECONDS=60

# --- Worker, seed and logging
WORKER_SHUTDOWN_TIMEOUT_SECONDS=25
SEED_TOKEN_TTL_HOURS=24
# One of CRITICAL, ERROR, WARNING, INFO, DEBUG.
LOG_LEVEL=INFO
