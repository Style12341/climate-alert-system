      "name": "4. Alerts",
      "item": [
        {
          "name": "Create alert",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Before any assertion, so one failed check does not cascade into later requests.",
                  "var captured;",
                  "try { captured = pm.response.json(); } catch (error) { captured = {}; }",
                  "if (captured && captured.id) {",
                  "    pm.environment.set('alert_id', String(captured.id));",
                  "}",
                  "pm.test(\"Status is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Alert is returned\", function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.event_type).to.eql('hail');",
                  "    pm.expect(body.threshold).to.eql('70.50');",
                  "    pm.expect(String(body.field_id)).to.eql(String(pm.environment.get('field_id')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/fields/{{field_id}}/alerts",
              "host": [
                "{{base_url}}"
