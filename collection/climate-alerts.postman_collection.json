                  "// Before any assertion, so one failed check does not cascade into later requests.",
                  "var captured;",
                  "try { captured = pm.response.json(); } catch (error) { captured = {}; }",
                  "if (captured && captured.next_cursor) {",
                  "    pm.environment.set('next_cursor', String(captured.next_cursor));",
                  "}",
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"One item and a cursor are returned\", function () {",
                  "    var body = pm.response.json();",
                  "    pm.expect(body.items.length).to.eql(1);",
                  "    pm.expect(body.next_cursor).to.eql(body.items[0].id);",
                  "});"
                ]
              }
