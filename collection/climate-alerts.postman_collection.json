                  "pm.test(\"Items are older than the cursor\", function () {",
                  "    var cursor = Number(pm.environment.get('next_cursor'));",
                  "    var items = pm.response.json().items;",
                  "    pm.expect(items.length).to.eql(1);",
                  "    pm.expect(items[0].id).to.be.below(cursor);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/notifications?limit=1&cursor={{next_cursor}}",
              "host": [
